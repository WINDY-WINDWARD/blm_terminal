# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# pytest scratch state (sandboxed runs cannot use the OS temp dir)
/.tmp/
/backend/.tmp/
/backend/tests/_tmp_documents/
/backend/.pytest_local/
/backend/pytest-cache-files-*/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

backend.log*
backend/logs/

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# python 
__pycache__/
*.pyc
*.pyo
*.pyd
*.env
*.venv
venv/
env/

data.db*
data_test.db
ticker.db

# cookies (browser session data - platform specific)
cookies/*.pkl
cookies/manifest.json

# network captures
*.har
*credentials.json
# Electron & PyInstaller build outputs
/dist/
/backend/dist/
/backend/build/
/backend/*.spec

dist-*/

# BLM license system: baked build-time config (regenerate via scripts/gen-license-config.js)

# Precomputed dependency tree for desktop builds
npm-deps.json

# git worktrees
.worktrees/
worktrees/
.superpowers/


# Vendor sidecar binaries
vendor/cliproxyapi/runtime/cliproxyapi*
# Encrypted provider secrets written beside the dev DB; never commit
provider_vault.enc

# graphify knowledge graph output (local only)
graphify-out/
