{
  "appId": "com.blm.terminal",
  "productName": "BLM Terminal",
  "directories": {
    "output": "dist-desktop"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "files": [
    "electron/**/*",
    "server.js",
    "server/**/*",
    ".next/**/*",
    "public/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist-backend/blm-backend.exe",
      "to": "blm-backend/blm-backend.exe"
    },
    {
      "from": "node_modules",
      "to": "node_modules"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
