{
  "appId": "com.blm.terminal",
  "productName": "BLM Terminal",
  "directories": {
    "output": "dist-desktop"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "files": [
    "electron/**/*",
    "server.js",
    "server/**/*",
    ".next/**/*",
    "!.next/cache/**/*",
    "!.next/dev/**/*",
    "public/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "backend/dist/blm-backend.exe",
      "to": "blm-backend/blm-backend.exe"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sharp/**/*",
    "**/node_modules/@img/**/*",
    "**/node_modules/libsodium-wrappers/**/*.wasm"
  ],
  "win": {
    "icon": "electron/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "publish": [
    {
      "provider": "generic",
      "url": "https://blmterminal.windytech.org"
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "electron/icon.ico",
    "uninstallerIcon": "electron/icon.ico"
  }
}
