{
  "name": "blm_terminal",
  "version": "2026.10.9",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build && npm run test",
    "build:next": "next build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/build_backend.ps1",
    "build:backend:mac": "bash ./scripts/build_backend.sh",
    "build:desktop": "npm run build:next && npm run build:backend && electron-builder --win --config electron-builder.json",
    "build:desktop:mac": "npm run build:next && npm run build:backend:mac && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config electron-builder.json",
    "publish:binaries": "powershell -ExecutionPolicy Bypass -File ./scripts/publish_binaries.ps1",
    "build:desktop:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/build_desktop_fast.ps1",
    "publish:desktop": "npm run build:next && npm run build:backend && node scripts/create_release.js && electron-builder --win --config electron-builder.json --publish always",
    "start": "cross-env NODE_ENV=production node server.js",
    "electron": "npm run build:next && cross-env NODE_ENV=production electron .",
    "electron:prod": "cross-env NODE_ENV=production electron .",
    "release": "node scripts/release.js",
    "pack:desktop": "electron-builder --win dir",
    "pack:desktop:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --config electron-builder.json",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:release": "echo 'No verification script configured'",
    "stage:cliproxyapi": "powershell -ExecutionPolicy Bypass -File ./scripts/stage_cliproxyapi.ps1",
    "stage:cliproxyapi:mac": "bash ./scripts/stage_cliproxyapi.sh",
    "verify:cliproxyapi": "powershell -ExecutionPolicy Bypass -File ./scripts/stage_cliproxyapi.ps1 -VerifyOnly",
    "verify:cliproxyapi:mac": "bash ./scripts/stage_cliproxyapi.sh vendor/cliproxyapi/runtime --verify-only"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "effect": "^3.20.0",
    "electron-updater": "^6.8.9",
    "http-proxy": "^1.18.1",
    "jotai": "^2.18.0",
    "libsodium-wrappers": "^0.8.4",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.576.0",
    "next": "^16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-split": "^2.0.14",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "get-port": "^7.2.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.0"
  }
}
