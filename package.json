{
  "name": "blm_terminal",
  "version": "2026.11.5",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build && npm run test",
    "build:next": "next build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/build_backend.ps1",
    "build:backend:mac": "bash ./scripts/build_backend.sh",
    "build:desktop": "npm run build:next && npm run build:backend && electron-builder --win --config electron-builder.json",
    "build:desktop:mac": "npm run build:next && npm run build:backend:mac && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config electron-builder.json",
    "publish:binaries": "powershell -ExecutionPolicy Bypass -File ./scripts/publish_binaries.ps1",
    "build:desktop:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/build_desktop_fast.ps1",
    "publish:desktop": "npm run build:next && npm run build:backend && node scripts/create_release.js && electron-builder --win --config electron-builder.json --publish always",
    "start": "cross-env NODE_ENV=production node server.js",
    "electron": "npm run build:next && cross-env NODE_ENV=production electron .",
    "electron:prod": "cross-env NODE_ENV=production electron .",
    "release": "node scripts/release.js",
    "pack:desktop": "electron-builder --win dir",
    "pack:desktop:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --config electron-builder.json",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:release": "node scripts/verify_release.js",
    "verify:release:live": "node scripts/verify_release.js --live --binary",
    "audit": "npm audit",
    "audit:backend": "node scripts/audit_backend.js",
    "stage:cliproxyapi": "powershell -ExecutionPolicy Bypass -File ./scripts/stage_cliproxyapi.ps1",
    "stage:cliproxyapi:mac": "bash ./scripts/stage_cliproxyapi.sh",
    "verify:cliproxyapi": "powershell -ExecutionPolicy Bypass -File ./scripts/stage_cliproxyapi.ps1 -VerifyOnly",
    "verify:cliproxyapi:mac": "bash ./scripts/stage_cliproxyapi.sh vendor/cliproxyapi/runtime --verify-only"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "electron-updater": "^6.8.9",
    "http-proxy": "^1.18.1",
    "jotai": "^2.18.0",
    "libsodium-wrappers": "^0.8.4",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.576.0",
    "next": "^16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-split": "^2.0.14",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "get-port": "^7.2.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.0.2",
    "msw": "^2.13.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.5",
    "follow-redirects": "^1.16.3",
    "nanoid": "^3.3.20",
    "js-yaml": "^4.3.2",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7",
    "@humanfs/node": "^0.16.8",
    "undici": "^7.30.2",
    "jsdom": {
      "undici": "^7.30.2"
    },
    "node-gyp": {
      "undici": "^6.29.1"
    },
    "minimatch@^9": "11.0.9",
    "minimatch@^10": "11.0.9",
    "minimatch@^3": {
      "brace-expansion": "^1.1.22"
    },
    "minimatch@^5": {
      "brace-expansion": "^2.1.8"
    }
  }
}
