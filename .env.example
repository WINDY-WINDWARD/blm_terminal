# OpenAlgo API (server-only - NOT exposed to browser)
OPENALGO_URL=http://localhost:8800
OPENALGO_API_KEY=89343c2a530ee92701713bfec3b8e3de0bc39a8cdfeb14b86cf36f5fd0706f7f

# API Configuration (server-only)
OPENALGO_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=60

# Client-side (exposed to browser)
NEXT_PUBLIC_OPENALGO_WS_URL=ws://localhost:8765
NEXT_PUBLIC_OPENALGO_DEFAULT_EXCHANGE=NSE
NEXT_PUBLIC_NEWS_WS_URL=ws://localhost:4455/ws/news
# Optional dev override for the market-data WebSocket. When unset
# (production default), the browser derives the WS URL from
# window.location — e.g. on https://blm.example.com the WS becomes
# wss://blm.example.com/ws/market, and the production reverse proxy
# forwards the upgrade to the Python backend on 4455.
NEXT_PUBLIC_MARKET_WS_URL=

# Python analytics backend (server-only)
PYTHON_BACKEND_URL=http://localhost:4455

