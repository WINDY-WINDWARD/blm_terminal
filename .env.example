# OpenAlgo API Configuration (SERVER-ONLY - Never expose to browser)
# These variables are used only on the backend and never sent to the client
OPENALGO_URL=http://localhost:8800
OPENALGO_API_KEY=your_api_key_here

# API Server Configuration
# OPENALGO_TIMEOUT_MS - Request timeout in milliseconds (default: 10000)
# RATE_LIMIT_PER_MINUTE - Global rate limit for API endpoints (default: 60)
OPENALGO_TIMEOUT_MS=10000
RATE_LIMIT_PER_MINUTE=60

# Client-Side Configuration (NEXT_PUBLIC_ prefix means these ARE exposed to browser)
# WebSocket URL for real-time data
NEXT_PUBLIC_OPENALGO_WS_URL=ws://localhost:8765
# Default exchange for market data (e.g., NSE, BSE)
NEXT_PUBLIC_OPENALGO_DEFAULT_EXCHANGE=NSE

# Database Configuration
DATABASE_URL="file:./prisma/dev.db"
