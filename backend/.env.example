# Python FastAPI backend environment variables
# Copy to .env and fill in values

# NSE base URL (do not change unless testing against a mirror)
NSE_BASE_URL=https://www.nseindia.com

# Path to the SQLite database for the Python backend
DB_PATH=./data.db

# Port the uvicorn server listens on
PORT=4455

# Milliseconds to wait between consecutive NSE API calls (rate-limit courtesy)
NSE_REQUEST_DELAY_MS=500

# How long (seconds) a cached NSE response is considered fresh before re-fetching
NSE_CACHE_TTL_SECONDS=300

# Use the async NSE client (httpx.AsyncClient) as the active backend
# for change-ranges and symbol-data. Default: true.
#
# The async client keeps a single httpx.AsyncClient per event loop,
# which is REQUIRED for the WS /ws/market handler — the rate limiter's
# asyncio.Semaphore and the http client must all be bound to the same
# event loop as the WS handler. The sync facade (false) goes through
# asyncio.run() per call which creates a fresh loop each time, and
# previously caused "Semaphore ... is bound to a different event loop"
# RuntimeErrors visible in the backend logs.
USE_ASYNC_NSE=true

# Environment mode: development | staging | production
# In staging/production, secret_key and ADMIN_PASSWORD validation fails fast if missing.
ENV=development

# JWT secret key for signing auth tokens (REQUIRED in non-development mode; min 16 chars)
# Generate via: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production

# Initial password for default admin account on fresh DB (REQUIRED in non-development mode)
ADMIN_PASSWORD=

# Log level: DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# OpenAI-compatible LLM API  (used by POST /api/ai/summarize)
# ---------------------------------------------------------------------------
# Base URL of any OpenAI-compatible provider:
#   OpenAI:         https://api.openai.com/v1          (default)
#   Azure OpenAI:   https://<resource>.openai.azure.com/openai/deployments/<deploy>
#   Ollama (local): http://localhost:11434/v1
#   LM Studio:      http://localhost:1234/v1
#   Groq:           https://api.groq.com/openai/v1
#   Together AI:    https://api.together.xyz/v1
#   vLLM:           http://localhost:8000/v1
AI_API_BASE_URL=https://api.openai.com/v1

# API key for the provider above.
# For local providers (Ollama, LM Studio) set to any non-empty string, e.g. "none"
AI_API_KEY=sk-...

# Model name as recognised by the provider (e.g. gpt-4o-mini, llama3.2, gemma3:4b)
AI_MODEL=gpt-4o-mini

# Maximum output tokens per summarise request (64–2048)
AI_MAX_TOKENS=512

# Sampling temperature — lower = more deterministic/factual (0.0–2.0)
AI_TEMPERATURE=0.3

OPENCODE_ZEN_API_KEY="sk-**"

# ---------------------------------------------------------------------------
# AI Picks — Zen API resilience (Phase 1 fix for httpx.ReadTimeout)
# The Hunter/Verifier deep-research loops make 6-8 parallel tool calls per turn
# and reason over 4k tokens of output. With a 120s timeout the 7th-3rd call
# was timing out. 300s + 2 retries gives enough headroom without re-architecting.
# ---------------------------------------------------------------------------
# Per-call timeout in seconds (default 300 = 5 min)
ZEN_API_TIMEOUT_SECONDS=300.0
# Number of retries on httpx.ReadTimeout / ConnectTimeout before failing (default 2)
ZEN_API_MAX_RETRIES=2
# Sleep between retries in seconds (default 5)
ZEN_API_RETRY_BACKOFF_SECONDS=5.0
