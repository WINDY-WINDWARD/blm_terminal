# Python FastAPI backend environment variables
# Copy to .env and fill in values

# NSE base URL (do not change unless testing against a mirror)
NSE_BASE_URL=https://www.nseindia.com

# Path to the SQLite database for the Python backend
# This is separate from the Next.js prisma/dev.db
DB_PATH=./data.db

# Port the uvicorn server listens on
PORT=4455

# Milliseconds to wait between consecutive NSE API calls (rate-limit courtesy)
NSE_REQUEST_DELAY_MS=500

# How long (seconds) a cached NSE response is considered fresh before re-fetching
NSE_CACHE_TTL_SECONDS=300

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OpenAI-compatible LLM API  (used by POST /api/ai/summarize)
# ---------------------------------------------------------------------------
# Base URL of any OpenAI-compatible provider:
#   OpenAI:         https://api.openai.com/v1          (default)
#   Azure OpenAI:   https://<resource>.openai.azure.com/openai/deployments/<deploy>
#   Ollama (local): http://localhost:11434/v1
#   LM Studio:      http://localhost:1234/v1
#   Groq:           https://api.groq.com/openai/v1
#   Together AI:    https://api.together.xyz/v1
#   vLLM:           http://localhost:8000/v1
AI_API_BASE_URL=https://api.openai.com/v1

# API key for the provider above.
# For local providers (Ollama, LM Studio) set to any non-empty string, e.g. "none"
AI_API_KEY=sk-...

# Model name as recognised by the provider (e.g. gpt-4o-mini, llama3.2, gemma3:4b)
AI_MODEL=gpt-4o-mini

# Maximum output tokens per summarise request (64–2048)
AI_MAX_TOKENS=512

# Sampling temperature — lower = more deterministic/factual (0.0–2.0)
AI_TEMPERATURE=0.3

OPENCODE_ZEN_API_KEY="sk-**"
